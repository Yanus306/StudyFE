<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".presentation.ui.main.HomeFragment">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="오늘도 좋은 하루입니다!"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="2026.08.03 오늘의 점검"
        android:textColor="#424242"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_title"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_result"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_result_box"
        android:paddingHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subTitle">

        <TextView
            android:id="@+id/tv_progress_count"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_progress_circle"
            android:fontFamily="@font/pretendard_semibold"
            android:gravity="center"
            android:text="0 / 6"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_progress_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="44dp"
            android:fontFamily="@font/pretendard_semibold"
            android:text="오늘의 점검 진행률"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/tv_progress_count"
            app:layout_constraintTop_toTopOf="@id/tv_progress_count" />

        <TextView
            android:id="@+id/tv_progress_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="오늘의 점검을\n진행해 주세요!"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toStartOf="@id/tv_progress_title"
            app:layout_constraintTop_toBottomOf="@id/tv_progress_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/layout_check_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/layout_result"
        app:layout_constraintStart_toStartOf="@id/layout_result"
        app:layout_constraintTop_toBottomOf="@id/layout_result">

        <include
            android:id="@+id/item_check1"
            layout="@layout/item_check"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <include
            android:id="@+id/item_check2"
            layout="@layout/item_check"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <include
            android:id="@+id/item_check3"
            layout="@layout/item_check"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <include
            android:id="@+id/item_check4"
            layout="@layout/item_check"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <include
            android:id="@+id/item_check5"
            layout="@layout/item_check"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <include
            android:id="@+id/item_check6"
            layout="@layout/item_check"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_attendance"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_main_btn"
        android:fontFamily="@font/pretendard_semibold"
        android:text="점검 완료 후 출근하기"
        android:textColor="@color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/layout_result"
        app:layout_constraintStart_toStartOf="@id/layout_result" />

</androidx.constraintlayout.widget.ConstraintLayout>